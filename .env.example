PORT=3000
NODE_ENV=development

# Set this for any shared or internet-exposed instance.
ADMIN_TOKEN=change_me_to_a_long_random_value

# When enabled, the server refuses to start without ADMIN_TOKEN.
# NODE_ENV=production also makes ADMIN_TOKEN mandatory.
REQUIRE_ADMIN_TOKEN=0

# Protect POST /api/backtest with ADMIN_TOKEN.
# Defaults to enabled when ADMIN_TOKEN is set.
BACKTEST_REQUIRES_ADMIN=1

# Run /api/backtest in a short-lived child process so live ticks/WebSockets stay responsive.
BACKTEST_WORKER_ENABLED=1
BACKTEST_TIMEOUT_MS=600000

DEFAULT_CASH=100000
TICK_MS=2000
CANDLE_TICKS=30
COMMISSION_RATE=0.001
SLIPPAGE_PCT=0.0005
STATE_SAVE_INTERVAL=10000

# Required for stock and GOLD live prices.
TWELVEDATA_API_KEY=
